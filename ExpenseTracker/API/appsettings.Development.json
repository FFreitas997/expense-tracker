{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:8080"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Content-Type", "Authorization" ],
    "AllowCredentials": false,
    "AllowWildcardOrigins": false,
    "PreflightMaxAgeMinutes": 1
  },
  "RateLimiter": {
    "Enabled": true,
    "PermitLimit": 60,
    "WindowMinutes": 1,
    "QueueLimit": 0,
    "RetryAfterSeconds": 60
  },
  "Database": {
    "ConnectionString": "Server=localhost;Database=expense_tracker_db;Trusted_Connection=True;TrustServerCertificate=True;",
    "MaxRetryCount": 3,
    "CommandTimeout": 30,
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true
  },
  "InMemoryCache": {
    "CacheSizeLimit": 1000,
    "CacheCompactionPercentage": 0.20,
    "ExpirationScanFrequency": "00:02:00",
    "TrackStatistics": true
  },
  "Identity": {
    "Password": {
      "PasswordMinLength": 12,
      "RequireDigit": true,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireNonAlphanumeric": true,
      "RequiredUniqueChars": 6
    },
    "Lockout": {
      "AllowedForNewUsers": true,
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutTimeSpan": "00:30:00"
    },
    "User": {
      "RequireUniqueEmail": true,
      "AllowedUserNameCharacters": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@.-_+"
    },
    "SignIn": {
      "RequireConfirmedEmail": false,
      "RequireConfirmedAccount": false
    },
    "Token": {
      "LifespanHours": 2
    }
  },
  "Quartz": {
    "InstanceName": "ExpenseTrackerScheduler",
    "MaxConcurrency": 5,
    "WaitForJobs": true,
    "UsePersistentStore": true
  },
  "ObservabilitySettings": {
    "ServiceName": "expense-tracker-api",
    "ServiceVersion": "1.0.0",
    "ServiceEnvironment": "development",
    "EnableConsoleExporter": true,
    "Otlp": {
      "Endpoint": "http://localhost:4317"
    },
    "Logging": {
      "MinimumLevel": "Debug",
      "FilePath": "logs/expense-tracker-.log",
      "EnableFileOutput": true
    }
  },
  "Jwt": {
    "SecretKey": "your-secret-key",
    "Issuer": "expense-tracker-api",
    "Audience": "expense-tracker-api",
    "ExpirationMinutes": 60,
    "RefreshTokenDays": 7 
  }
}
