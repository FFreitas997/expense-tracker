{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimiter": {
    "Enabled": true,
    "PermitLimit": 60,
    "WindowMinutes": 1,
    "QueueLimit": 0,
    "RetryAfterSeconds": 60
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "your-email@gmail.com",
    "Password": "your-app-password",
    "FromAddress": "no-reply@expensetracker.com",
    "FromName": "Expense Tracker",
    "UseSsl": true
  },
  "AppSettings": {
    "FrontendBaseUrl": "https://yourfrontend.com"
  }
}
